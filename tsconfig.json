{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@db/*": ["./src/db/*"],
      "@storage/*": ["./src/storage/*"]
    },
    "noUncheckedIndexedAccess": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["node_modules", "dist"]
}
